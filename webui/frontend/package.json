{
  "name": "pitantum-frontend",
  "version": "0.1.0",
  "description": "piTantum (Tempus Tantum) -- Omnia, Lucili, aliena sunt, tempus tantum nostrum est. (Seneca, Ep. I,1) -- school timetable manager.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test src/lib/constraint_levels.test.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.5",
    "@sveltejs/kit": "^2.6.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^25.6.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "svelte": "^5.0.0",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^3.4.13",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^5.4.8"
  },
  "dependencies": {
    "@tanstack/svelte-query": "^6.1.25"
  }
}
