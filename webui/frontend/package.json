{
  "name": "pitantum-frontend",
  "version": "0.1.0",
  "description": "piTantum (Tempus Tantum) -- Omnia, Lucili, aliena sunt, tempus tantum nostrum est. (Seneca, Ep. I,1) -- school timetable manager.",
  "contributors": [
    "Fernando Gargiulo",
    "Giovanni Borghi",
    "Matteo Mariani",
    "Stefano Bertozzi"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.mjs\"",
    "test:e2e:cypress": "cypress run",
    "test:e2e:cypress:open": "cypress open",
    "test:e2e:playwright": "playwright test",
    "test:e2e": "npm run test:e2e:cypress",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^3.0.5",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cytoscape": "^3.31.0",
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.6.2",
    "cypress": "^16.2.1",
    "postcss": "^8.5.32",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@tanstack/svelte-query": "^6.3.6",
    "cytoscape": "^3.34.4",
    "cytoscape-fcose": "^2.2.0",
    "echarts": "^6.0.0"
  }
}
