# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Node
node_modules/
.svelte-kit/
build/
dist/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Project-specific runtime artifacts
data/*.db
webui/data/*.db
webui/data/*.db-shm
webui/data/*.db-wal
webui/data/runs/
output/
engine/scripts/output/
proofs/

# Exception: MEGA benchmark xlsx outputs are tracked so reviewers
# can inspect the final orario without re-running the pipeline.
!engine/scripts/output/mega/
!engine/scripts/output/mega/*.xlsx

# Pickled snapshots / engine scratch artifacts
engine/*.pkl
engine/scripts/*.pkl
schedule/*.pkl

# Claude Code worktrees (transient development branches)
.claude/worktrees/

# Audit / scratch notes meant to be read by the user, not committed
AUDIT.md
TASK*_REPORT.md

# Logs
*.log

# LaTeX intermediate artifacts (the .tex source and the .pdf output
# are tracked; the temp files generated during compilation are not)
docs/*.aux
docs/*.toc
docs/*.lof
docs/*.out
docs/*.fls
docs/*.fdb_latexmk
docs/*.synctex.gz

# Secrets / keys (do NOT commit)
*.pem
*.key
*.crt
*.p12
*.pfx
.env
.env.*
