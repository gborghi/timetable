# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Node
node_modules/
.svelte-kit/
build/
dist/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Project-specific runtime artifacts
data/*.db
webui/data/*.db
webui/data/*.db-shm
webui/data/*.db-wal
webui/data/runs/
# Everything else webui/data/ and webui/logs/ accumulate at runtime:
# operator-triggered DB snapshot zips, the pid file start.sh writes,
# per-service logs. All regenerable, none reviewable, and they showed
# up as untracked noise on every `git status`.
webui/data/snapshots/
webui/logs/
/output/
proofs/

# engine/scripts/output/ holds pipeline artifacts. We track the
# canonical demo-profile outputs so reviewers can inspect them
# without re-running the engine; everything else under output/
# (intermediate Phase A dumps, run logs, throwaway pickles,
# benchmark scratch) is gitignored.
engine/scripts/output/**/*
!engine/scripts/output/*/
!engine/scripts/output/*/orario_*.xlsx
!engine/scripts/output/*/solution_timetable_*_optimized.pkl

# Pickled snapshots / engine scratch artifacts
engine/*.pkl
engine/scripts/*.pkl
schedule/*.pkl

# Demo-profile pickles under engine/scripts/data/<profile>/ ARE tracked
# (small / medium / big / huge / superhuge / mega school + profs). They
# back the dashboard's "Importa profilo" dropdown -- without them the
# dropdown shows only mega. Generation script: scripts/rebuild_profiles.{sh,ps1}.
# The .sqlite profile DBs are tracked too, but their WAL sidecars are
# per-machine scratch that a backend booted against a profile leaves
# behind -- never commit those.
engine/scripts/data/**/*.sqlite-shm
engine/scripts/data/**/*.sqlite-wal

# Claude Code worktrees (transient development branches)
.claude/worktrees/

# Scratch report files generated by Claude Code workflows; the
# canonical AUDIT.md is tracked, throwaway TASK*_REPORT.md notes
# stay out.
TASK*_REPORT.md

# Logs
*.log

# LaTeX intermediate artifacts (the .tex source and the .pdf output
# are tracked; the temp files generated during compilation are not)
docs/*.aux
docs/*.toc
docs/*.lof
docs/*.lot
docs/*.out
docs/*.fls
docs/*.fdb_latexmk
docs/*.synctex.gz
docs/*.bbl
docs/*.bcf
docs/*.blg
docs/*.idx
docs/*.ilg
docs/*.ind
docs/*.run.xml
docs/*-blx.bib

# Secrets / keys (do NOT commit)
*.pem
*.key
*.crt
*.p12
*.pfx
.env
.env.*

# E2E test artifacts (Cypress + Playwright)
webui/frontend/cypress/screenshots/
webui/frontend/cypress/videos/
webui/frontend/cypress/downloads/
webui/frontend/playwright-report/
webui/frontend/test-results/
webui/frontend/playwright/artifacts/
tests/benchmarks/results/*.pkl
# Raw benchmark sweep dumps (regenerable). Curated results live in
# tests/benchmarks/results/bp_scalability.json and
# docs/manual/benchmarks/results.csv, which are force-added when needed.
tests/benchmarks/results/*.csv

# Stray LaTeX log at repo root (the real build lives under docs/)
/manual.log
