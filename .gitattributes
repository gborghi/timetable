# Keep shell scripts LF-only so they work on Linux/macOS even when the
# repo is cloned on a Windows host with autocrlf=true. Windows .bat must
# stay CRLF for cmd.exe to parse them reliably.
*.sh   text eol=lf
*.bat  text eol=crlf

# Binary assets: NEVER let autocrlf or any text filter touch these.
# Without these markers, a Windows clone with core.autocrlf=true
# silently rewrites every CR/LF byte inside the file, corrupting it.
# That is the root cause of "manual.pdf does not open" reports.
*.pdf       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.tgz       binary
*.7z        binary
*.pkl       binary
*.pickle    binary
*.db        binary
*.sqlite    binary
*.sqlite3   binary
*.xlsx      binary
*.xls       binary
*.docx      binary
*.doc       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.eot       binary
*.mp4       binary
*.mov       binary
*.webp      binary
