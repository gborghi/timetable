#!/usr/bin/env bash
# pre-push hook: rebuild the three manual PDFs (manuale_generale,
# appendici_tecniche, manuale_completo) if any .tex source under
# docs/ or any .md under docs/ changed since the last push, and
# amend them to the pending push so GitHub stays in sync.
#
# Install once with:
#   git config core.hooksPath .githooks
#
# To skip on a single push:  PITANTUM_SKIP_PDF=1 git push
set -e

if [[ "${PITANTUM_SKIP_PDF:-}" == "1" ]]; then
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Only rebuild if docs sources changed in any commit being pushed
# (compare HEAD against the upstream branch's tip).
if git rev-parse --verify "@{u}" >/dev/null 2>&1; then
  CHANGED=$(git diff --name-only "@{u}"..HEAD -- 'docs/*.tex' \
            'docs/manual/**/*.tex' 'docs/*.md' 'webui/docs/*.md' \
            2>/dev/null || true)
else
  CHANGED="docs/manual_completo.tex"   # first push -- always build
fi

if [[ -z "$CHANGED" ]]; then
  exit 0
fi

if ! command -v lualatex >/dev/null 2>&1; then
  echo "[pre-push] lualatex non trovato; skip rebuild PDFs" >&2
  exit 0
fi

echo "[pre-push] rebuilding the three manual PDFs"
bash docs/build_manual.sh

# Amend any rebuilt PDFs into a single docs commit
NEED_COMMIT=0
for pdf in docs/manual_generale.pdf docs/appendici_tecniche.pdf \
           docs/manual_completo.pdf; do
  if ! git diff --quiet -- "$pdf"; then
    git add "$pdf"
    NEED_COMMIT=1
  fi
done
if [[ "$NEED_COMMIT" -eq 1 ]]; then
  git commit -m "docs: rebuild manual PDFs (3 outputs)"
  echo "[pre-push] manual PDFs rebuilt and committed"
fi
